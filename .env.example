# Copie para .env (que está no .gitignore) e ajuste. O Quarkus lê o .env
# da pasta onde você roda o comando.

# --- Desenvolvimento local com Mailpit (docker compose up -d) ---------------
# Emails de verdade não saem; aparecem em http://localhost:8025
QUARKUS_MAILER_MOCK=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_START_TLS=DISABLED
MAIL_FROM=no-reply@meusite.com
APP_NAME=Meu Site

# --- Produção (exemplo com Gmail; veja o README para SendGrid e SES) --------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_START_TLS=REQUIRED
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=senha-de-app-de-16-caracteres
# MAIL_FROM=seu-email@gmail.com

# Chave exigida no header X-API-Key. Gere uma longa e aleatória, ex.: openssl rand -hex 32
# EMAIL_API_KEY=
