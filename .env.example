# Copie para .env (que está no .gitignore) e ajuste. O Quarkus lê o .env
# da pasta onde você roda o comando. Use UM dos blocos de SMTP abaixo.

# Nome do site nos emails e onde a página /demo está acessível (base do link de redefinição)
APP_NAME=Meu Site
APP_BASE_URL=http://localhost:8080

# --- Opção A: Mailpit local (docker compose up -d) ---------------------------
# Nenhum email sai de verdade; todos aparecem em http://localhost:8025
QUARKUS_MAILER_MOCK=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_START_TLS=DISABLED
MAIL_FROM=no-reply@meusite.com
SUPPORT_EMAIL=suporte@meusite.com

# --- Opção B: Gmail (apague o bloco da opção A e descomente este) ------------
# Exige verificação em duas etapas na conta Google e uma "senha de app":
# myaccount.google.com > Segurança > Verificação em duas etapas > Senhas de app.
# NÃO use a senha normal da conta: o Gmail recusa.
# QUARKUS_MAILER_MOCK=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_START_TLS=REQUIRED
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=senha-de-app-de-16-letras
# MAIL_FROM=seu-email@gmail.com
# SUPPORT_EMAIL=seu-email@gmail.com

# --- Só para produção ---------------------------------------------------------
# Chave exigida no header X-API-Key. Gere uma longa e aleatória, ex.: openssl rand -hex 32
# EMAIL_API_KEY=
# A página /demo vem DESLIGADA fora do modo dev. Não ligue em produção.
# DEMO_ENABLED=false
